# Copy to .env (never commit the real file). Values can also be set as environment variables.
ENCOMPASS_API_BASE=https://api.elliemae.com
ENCOMPASS_INSTANCE_ID=BE11223344
# API user: use a dedicated admin/super-admin user so calculations and settings are visible
ENCOMPASS_USERNAME=api_admin
ENCOMPASS_PASSWORD=
ENCOMPASS_CLIENT_ID=
ENCOMPASS_CLIENT_SECRET=
# Optional: use a pre-issued bearer token instead of the password grant
# ENCOMPASS_TOKEN=
# Optional: CA bundle path for TLS-inspecting proxies
# ENCOMPASS_CA_BUNDLE=
